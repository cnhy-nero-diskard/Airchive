# Airchive collector configuration template.
# Copy to `.env` and fill in. `.env` is gitignored; this file MUST stay free of
# real secrets.

# --- LG ThinQ Connect API ---

# Personal Access Token issued from the LG ThinQ developer portal.
# Deployed runtime takes this from Secret Manager, never from a committed file.
LG_THINQ_PAT=replace-with-your-thinq-personal-access-token

# ISO 3166-1 alpha-2 country code of the ThinQ account (routes the API region).
LG_COUNTRY_CODE=PH

# Client ID. Generate ONCE (`python -c "import uuid; print(uuid.uuid4())"`),
# then persist it here and reuse it forever. Never regenerate per run.
LG_CLIENT_ID=replace-with-a-once-generated-uuid

# Target device identifier, taken from `airchive discover`.
LG_DEVICE_ID=replace-with-the-device-id-from-discover

# Energy property to poll. MUST appear in the device's energy profile
# (`energy_profile["result"]["property"]`); confirm with `airchive discover`.
LG_ENERGY_PROPERTY=replace-with-the-property-name-from-discover

# --- Firestore ---

# Firebase / Google Cloud project holding the telemetry database.
FIREBASE_PROJECT_ID=lg-ac-telemetry

# --- Collector behavior ---

# Sampling cadence in seconds. Default 300 (five minutes).
POLL_INTERVAL_SECONDS=300

# IANA timezone used to bucket local days and detect day rollover.
# Confirm empirically against observed counter resets (see docs/operations.md).
LG_DAY_TIMEZONE=Asia/Manila

# Logging verbosity: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Local development only ---

# Escape hatch for when Application Default Credentials cannot be used.
# Prefer `gcloud auth application-default login` and leave this unset.
# If set, the key file MUST live outside this repository. See docs/operations.md
# for revocation steps.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo/service-account-key.json
